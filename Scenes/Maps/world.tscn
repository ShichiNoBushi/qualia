[node name="WildSparkSign" parent="YSort" unique_id=251241764 instance=ExtResource("17_vi3vx")]
position = Vector2(912, 944)
scale = Vector2(2, 2)
label = "Wild Sparks"
textSouth = "Sparks appearing in the field are creatures that are beginning to manifest. By making contact with them you will begin a battle with wild creatures that will appear over time.[break]Summon your own familiars to fight with them and protect yourself. If you don't have any active familiars, enemies can attack you directly.[break]If you defeat them, you will be able to accumulate experience for yourself and the familiars you used in battle and collect qualia crystals dropped by the familiars you defeated."

